{
  "name": "skill-store",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Skill Store — a trust-first marketplace for Agent Skills. M0: verified catalog.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "tsx packages/pipeline/src/jobs/ingest.ts",
    "sync": "tsx packages/pipeline/src/jobs/sync.ts",
    "eval": "tsx packages/pipeline/src/jobs/eval.ts",
    "enrich:stars": "tsx packages/pipeline/src/jobs/enrich-stars.ts",
    "backfill:first-seen": "tsx packages/pipeline/src/jobs/backfill-first-seen.ts",
    "categorize:preview": "tsx packages/pipeline/src/jobs/categorize-preview.ts",
    "recategorize": "tsx packages/pipeline/src/jobs/recategorize.ts",
    "categorize:llm": "tsx packages/pipeline/src/jobs/categorize-llm.ts",
    "scene:renorm": "tsx packages/pipeline/src/jobs/scene-renorm.ts",
    "promote": "tsx packages/pipeline/src/jobs/promote.ts",
    "verdicts:migrate": "node packages/verdicts/scripts/migrate-legacy.mjs",
    "web": "npm run dev -w @skill-store/web",
    "web:build": "npm run build -w @skill-store/web",
    "web:index": "npm run index -w @skill-store/web",
    "typecheck": "tsc --noEmit",
    "web:typecheck": "npm run typecheck -w @skill-store/web",
    "status": "node scripts/status.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.2"
}
