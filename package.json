{
  "name": "skill-store",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Skill Store — a trust-first marketplace for Agent Skills. M0: verified catalog.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "tsx packages/pipeline/src/jobs/ingest.ts",
    "audit": "tsx packages/pipeline/src/jobs/audit.ts",
    "review": "tsx packages/pipeline/src/jobs/review.ts",
    "audit:l3": "tsx packages/pipeline/src/jobs/audit-l3.ts",
    "sync": "tsx packages/pipeline/src/jobs/sync.ts",
    "web": "npm run dev -w @skill-store/web",
    "web:build": "npm run build -w @skill-store/web",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
