{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Raybbish/skill-store/packages/schemas/collection-report.schema.json",
  "title": "CollectionReport",
  "description": "批量源仓库合集条目,v1。skill 数超过每仓上限(MAX_PER_REPO)的仓库,除采样收录外在 catalog/collections/<owner>/<repo>.json 保留一条仓库级记录指回上游",
  "type": "object",
  "required": ["schema_version", "id", "url", "skill_count", "sampled_count"],
  "properties": {
    "schema_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+/[A-Za-z0-9._-]+$", "description": "GitHub slug:owner/repo(owner 小写)" },
    "url": { "type": "string", "description": "上游仓库 URL" },
    "skill_count": { "type": "integer", "description": "采集时仓库内 SKILL.md 总数" },
    "sampled_count": { "type": "integer", "description": "实际采样收录进 catalog/skills 的条数" },
    "stars_github": { "type": ["integer", "null"] },
    "fetched_at": { "type": "string", "format": "date-time" }
  }
}
