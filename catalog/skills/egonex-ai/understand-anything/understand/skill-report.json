    "lint_pass": true,
    "what_en": "Once installed, Claude scans your codebase and writes knowledge-graph.json under .understand-anything/, which powers an interactive dashboard for exploring architecture, components, and their relationships.",
    "when_en": "Triggers when you run /understand or ask to analyze a codebase's architecture; defaults to the current directory, accepts a path. If the graph matches the latest commit, it asks rebuild, review, or nothing.",
    "say_en": [
      {
        "text": "/understand --language zh — build the knowledge graph in Chinese",
        "note": "Writes a Chinese graph under .understand-anything/"
      },
      {
        "text": "/understand --full — force a full rebuild of the graph",
        "note": "Ignores the existing graph and rescans everything"
      },
      {
        "text": "/understand ../other-project — analyze that directory",
        "note": "Analyzes the given path instead of the current directory"
      }
