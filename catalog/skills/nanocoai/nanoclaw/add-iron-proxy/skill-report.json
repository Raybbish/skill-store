    "lint_pass": true,
    "what_en": "Installs the Iron Proxy gateway with the official Iron Control console and PostgreSQL for NanoClaw. Outbound requests go through identity checks, an allowlist and human approval before credentials are forwarded upstream.",
    "when_en": "Use it when you pick the Iron gateway, add its management UI, or configure credentials and grants; it also restores the proxy and approval bridge.",
    "say_en": [
      {
        "text": "Install the Iron Proxy gateway and the Iron Control console for me",
        "note": "Pulls images, creates the database, registers this proxy"
      },
      {
        "text": "Grant the secret with id xxx to this installation",
        "note": "Only grants an existing credential to the recorded principal"
      },
      {
        "text": "Allow an extra host: api.example.com",
        "note": "Adds it to the local egress allowlist"
      }
