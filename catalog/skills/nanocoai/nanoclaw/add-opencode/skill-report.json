    "lint_pass": true,
    "what_en": "Installs OpenCode as a NanoClaw agent provider: pulls provider files from the providers branch, wires host and container barrels, adds the SDK and CLI, and rebuilds the image. Groups can then run on OpenRouter, OpenAI, DeepSeek, etc.",
    "when_en": "Use when you want a group to run on OpenCode instead of the default claude provider, or when installing that provider; switch with ncl groups config update --provider opencode.",
    "say_en": [
      {
        "text": "Install the OpenCode provider into this repo and rebuild the image",
        "note": "Fetches the providers branch, copies files, installs deps, rebuilds"
      },
      {
        "text": "Switch a group's provider to opencode and restart it",
        "note": "Writes provider into container_configs and restarts the group"
      },
