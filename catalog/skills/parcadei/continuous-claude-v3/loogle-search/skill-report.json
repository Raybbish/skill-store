    "what_en": "After installation, Claude can search Mathlib for lemmas by type signature pattern, returning matching lemma names.",
    "when_en": "Triggered when you know the type shape of a lemma but not its name during a Lean proof, or when exploring available lemmas for a type.",
    "say_en": [
      {
        "text": "Search type signature: Nontrivial _ ↔ _",
        "note": "Returns all lemmas related to Nontrivial equivalence."
      },
      {
        "text": "Search function pattern: (?a → ?b) → List ?a → List ?b",
        "note": "Returns map-like functions such as List.map."
      },
