    "what_en": "Claude can query Azure costs, forecast future spending, and run cost optimization to suggest waste-reduction actions (e.g., rightsizing VMs, removing orphaned resources). Requires Cost Management Reader, Monitoring Reader, and Reader roles.",
    "when_en": "Triggers on cost-related keywords like 'Azure costs', 'Azure bill', 'cost breakdown', or when forecasting/optimizing spending. Not for deploying resources, provisioning, diagnostics, or security audits.",
    "say_en": [
      {
        "text": "Can you show the Azure cost breakdown for this month?",
        "note": "Runs the cost query workflow."
      },
      {
        "text": "Forecast our Azure spending for next quarter.",
        "note": "Calls the forecast API."
      },
      {
        "text": "Find idle resources we can remove to save money.",
        "note": "Starts cost optimization."
