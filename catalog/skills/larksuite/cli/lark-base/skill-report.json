    "lint_pass": true,
    "what_en": "After enabling, Claude uses lark-cli base commands to operate Feishu Base: create/manage tables, fields, records, views, formula/lookup fields, forms, dashboards, workflows, and role permissions.",
    "when_en": "Triggered when the user mentions Base or a /base/ link, or asks to operate tables, records, or views in a Base.",
    "say_en": [
      {
        "text": "Create a new Base with an 'Orders' table containing order number and amount fields.",
        "note": "Uses base-create with initial table config."
      },
      {
        "text": "Batch write these customer records to the table.",
        "note": "Uses record-batch-create."
      },
      {
        "text": "Count orders by region and return the top 3.",
        "note": "Uses data-query aggregation."
      }
    ]
