    "say_en": [
      {
        "text": "Create a Base named Customer Feedback with fields for feedback content and date.",
        "note": "Creates the Base and fields, then reports the result."
      },
      {
        "text": "Count this table's open todos grouped by Owner, sorted from highest to lowest.",
        "note": "Runs an aggregate query and returns sorted results."
      },
