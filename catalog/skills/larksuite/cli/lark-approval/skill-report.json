      {
        "text": "帮我查一下我的审批待办",
        "note": "会列出待办审批列表"
      },
      {
        "text": "同意这笔报销审批，备注“同意”",
        "note": "会提交同意操作"
      },
      {
        "text": "发起一个请假审批",
        "note": "会先搜索定义并引导填写表单"
      }
    ],
