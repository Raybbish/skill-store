    "lint_pass": true,
    "what_en": "When auditing Hex dependencies, Claude runs 8 supply-chain rules on changed packages, enriches with Hex API metadata, wraps external tools, and outputs a risk-graded table with details. It writes a run record and never modifies files.",
    "when_en": "Typically after `mix deps.update`/`get` or when reviewing `mix.lock` PR diffs. Triggered by `/phx:deps-audit` or with `--preview <pkg>` for single package preview.",
    "say_en": [
      {
        "text": "Audit the latest dependency changes.",
        "note": "Triggers default mode."
      },
      {
        "text": "Check if httpoison upgrade is safe.",
        "note": "Uses --preview flag."
      },
      {
        "text": "Compare deps between current and main branch.",
