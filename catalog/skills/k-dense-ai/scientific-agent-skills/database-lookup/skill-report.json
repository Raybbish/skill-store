    "lint_pass": true,
    "what_en": "After install, Claude turns requests into reproducible queries against documented public database APIs: it picks authoritative databases, calls them within limits, and returns results with source, endpoint, parameters, and access date.",
    "when_en": "Triggered when the user needs a scientific, regulatory, financial, or other database-backed fact retrieved reproducibly from a named source rather than inferred from general knowledge.",
    "say_en": [
      {
        "text": "Look up aspirin's PubChem CID and molecular formula.",
        "note": "Fetches from PubChem and cites the source."
      },
      {
        "text": "List USGS records for M3+ earthquakes in California in 2023.",
        "note": "Paginates the API and reconciles the total count."
      },
      {
        "text": "Get BRCA1's UniProt sequence and functional annotation.",
        "note": "Retrieves from UniProt with the access date."
