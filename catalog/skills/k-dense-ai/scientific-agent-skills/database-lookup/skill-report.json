    "generated_at": "2026-09-03T08:09:54.387Z",
    "lint_pass": true,
    "what_en": "Claude maps a fact question to one of 78 cataloged public databases and queries its API with rate limits, instead of relying on memory. It checks counts and returns source, date, parameters; large pulls request confirmation first.",
    "when_en": "Triggers when a scientific, regulatory, financial, or other database-backed fact must be retrieved reproducibly from a named source instead of inferred from general knowledge.",
    "say_en": [
      {
        "text": "Find pathogenic BRCA1 variants in ClinVar and give IDs and significance.",
        "note": "Queries the ClinVar API and returns listed variants."
      },
      {
        "text": "Get M3+ earthquakes in California from USGS for the past week.",
        "note": "Calls the USGS API and filters by place and magnitude."
      },
      {
        "text": "Pull US monthly CPI from FRED for the last 10 years with series IDs.",
        "note": "Fetches via FRED API and cites the series ID."
      }
    ]
