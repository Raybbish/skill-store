    "generated_at": "2026-09-30T09:20:35.697Z",
    "lint_pass": true,
    "what_en": "After installing, Claude turns a fact question into a reproducible retrieval: pick an authoritative database, call its documented API with filters and pagination, reconcile counts, and report endpoints, parameters and access date.",
    "when_en": "Use when a database-backed fact must come reproducibly from a named source, e.g. scientific, regulatory or financial lookups. It asks before exceeding 10,000 records or 100 API calls.",
    "say_en": [
      {
        "text": "Look up aspirin's molecular weight and SMILES in PubChem, plus the endpoint used.",
        "note": "Returns the result with provenance."
      },
      {
        "text": "Use UniProt to get the TP53 protein sequence and reconcile the return count.",
        "note": "Reconciles counts first."
      },
      {
        "text": "Pull US CPI monthly data from FRED and state which endpoint you called.",
        "note": "Names endpoint and parameters."
      }
