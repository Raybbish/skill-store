    "lint_pass": true,
    "what_en": "After installation, Claude turns database requests into reproducible lookups: it selects authoritative sources from a catalog of 78 public databases, makes bounded API calls, verifies counts, and returns results with provenance (source, endpoint, date) instead of guessing from general knowledge.",
    "when_en": "Triggers when the user needs a scientific, regulatory, financial, or other database-backed fact retrieved reproducibly from a named source rather than inferred from general knowledge.",
    "say_en": [
      {
        "text": "Look up the Ensembl gene ID for human BRCA1.",
        "note": "Queries Ensembl and returns the ID with source."
      },
      {
        "text": "What earthquakes of magnitude 5+ did USGS record in the last week?",
        "note": "Calls the USGS earthquake API."
      },
      {
        "text": "Get US monthly CPI from FRED for the last three years.",
        "note": "Fetches the series from FRED."
      }
