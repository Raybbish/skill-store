    "what_en": "When enabled, Claude selects authoritative databases, makes bounded API calls, and returns results with provenance for reproducibility when you need verifiable data from public sources.",
    "when_en": "Triggered when you request data from specific databases like PubChem or UniProt, or need authoritative, verifiable factual information.",
    "say_en": [
      {
        "text": "Look up aspirin's chemical properties on PubChem.",
        "note": "Claude will call PubChem API for molecular data."
      },
      {
        "text": "Find UniProt annotations for BRCA1 gene.",
        "note": "Claude will call UniProt API for protein info."
