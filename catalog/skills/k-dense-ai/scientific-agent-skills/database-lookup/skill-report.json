    "lint_pass": true,
    "what_en": "On installation, when a database-backed fact is needed, Claude selects an authoritative database, makes bounded rate-limited API calls, verifies counts, and returns results with provenance so the lookup can be repeated.",
    "when_en": "Triggered when the user asks for a reproducible fact retrieval from a named scientific, regulatory, financial, or other public database.",
    "say_en": [
      {
        "text": "Look up the functional annotation of human BRCA1.",
        "note": "Returns sourced results via UniProt etc."
      },
      {
        "text": "Get the SMILES of aspirin from PubChem.",
        "note": "Returns the CID and structure."
      },
      {
        "text": "Retrieve US annual GDP for the last ten years.",
        "note": "Pulls from FRED with access date."
      }
    ]
