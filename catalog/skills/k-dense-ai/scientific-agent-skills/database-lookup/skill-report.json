    "generated_at": "2026-08-04T06:06:43.763Z",
    "lint_pass": true,
    "what_en": "After installation, Claude queries official public database APIs for facts needing verification, selects authoritative sources, makes bounded calls, and returns results with source, date, and count checks.",
    "when_en": "Triggered when a scientific, regulatory, financial, or other database-backed fact must be retrieved reproducibly from a named source, rather than inferred from general knowledge.",
    "say_en": [
      {
        "text": "List last week's 5+ magnitude earthquakes from USGS, with times and locations.",
        "note": "Fetches earthquake list from USGS with times and locations."
      },
      {
        "text": "Look up aspirin's molecular weight and SMILES from PubChem.",
        "note": "Queries PubChem and returns molecular info."
      },
      {
        "text": "Look up clinical variants for the BRCA1 gene from ClinVar.",
        "note": "Returns clinical variant records from ClinVar for that gene."
      }
    ]
