    "what_en": "Adds captions to an existing single-subject talking-head video without editing it. Analyzes the clip, recommends one of 35 identities, then generates and composites captions locally. Supports verbatim, cinematic embedded, and VFX captions.",
    "when_en": "Triggered when adding captions to a single-speaker video, especially for verbatim, cinematic, or VFX captions (e.g. '炸'), or a named catalog style. It checks the clip's suitability and may refuse unsuitable input.",
    "say_en": [
      {
        "text": "Add standard captions to this talking-head video.",
        "note": "Generates rail captions with embedded peak words."
      },
      {
        "text": "Make this phrase an embedded effect behind the speaker.",
        "note": "Produces a cinematic pure-embed caption."
      },
