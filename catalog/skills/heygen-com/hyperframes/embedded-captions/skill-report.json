    "what_en": "Once installed, Claude will add captions to a single-subject talking-head video: it checks the clip, transcribes and mattes the subject, generates captions in the chosen style (plain, cinematic embed, VFX, etc.), composites them onto the footage, and outputs a new captioned video.",
    "when_en": "Triggers when you provide a single-subject talking-head video and ask for plain verbatim captions, cinematic embedded captions, or 'explosive/VFX' captions, or specify one of the 35 catalog identities.",
    "say_en": [
      {
        "text": "Add default captions to this video, verbatim.",
        "note": "Runs Standard mode: rail plus an embedded peak."
      },
      {
        "text": "Make the word 'miracle' a cinematic embed behind the subject.",
        "note": "Uses Cinematic mode; that word becomes the hero."
      },
      {
        "text": "Give me a 'boom' style VFX caption.",
        "note": "Picks a matching themed identity from the catalog."
      }
    ]
